# ──────────────────────────────────────────────
# SatQuery AI Backend — Environment Variables
# ──────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/satquery

# General AI (agent reasoning + fallback vision)
AI_PROVIDER=gemini
AI_API_KEY=
VISION_MODEL=gemini-2.0-flash
TEXT_MODEL=gemini-2.0-flash

# Python ML Service
PYTHON_ML_URL=http://localhost:8000

# Specialist model configuration (set by ML service)
VQA_MODEL_ID=
VQA_MODEL_PATH=
CAPTION_MODEL_ID=
CAPTION_MODEL_PATH=
GROUNDING_MODEL_ID=
GROUNDING_MODEL_PATH=
CHANGE_MODEL_ID=
CHANGE_MODEL_PATH=
CHANGE_VQA_MODEL_ID=
CHANGE_VQA_MODEL_PATH=
OPTICAL_SAR_MODEL_ID=
OPTICAL_SAR_MODEL_PATH=

# File uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
